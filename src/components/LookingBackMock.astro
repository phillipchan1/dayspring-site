---
// LookingBackMock — interactive horizon pills matching the app's Looking Back
// view. Each pill reveals that horizon's real content shape on-voice.
interface WinBlock {
  heading: string;
  items: string[];
}
interface EbenezerPair {
  before: string;
  after: string;
  when: string;
}
interface Horizon {
  id: string;
  label: string;
  character: string;
  title: string;
  paragraphs: string[];
  signature?: string;
  wins?: WinBlock[];
  questions?: string[];
  ebenezer?: EbenezerPair[];
  themes?: string[];
}
interface Props {
  horizons: Horizon[];
  class?: string;
}
const { horizons, class: className = "" } = Astro.props;
const defaultId = horizons[0]?.id ?? "week";
---

<div class:list={["lb", className]} data-looking-back>
  <nav class="pills" aria-label="Reflection horizons">
    {
      horizons.map((h) => (
        <button
          type="button"
          class="pill"
          data-pill={h.id}
          aria-pressed={h.id === defaultId ? "true" : "false"}
        >
          {h.label}
        </button>
      ))
    }
  </nav>

  <div class="panels">
    {
      horizons.map((h) => (
        <div
          class="panel"
          data-panel={h.id}
          hidden={h.id !== defaultId}
          aria-labelledby={`lb-kicker-${h.id}`}
        >
          <p class="kicker mono" id={`lb-kicker-${h.id}`}>
            {h.label}ly · {h.character.toLowerCase()}
          </p>
          <h3>{h.title}</h3>
          {h.paragraphs.map((p) => <p class="body" set:html={p} />)}

          {
            h.wins && (
              <div class="wins">
                {h.wins.map((block) => (
                  <div class="win-col">
                    <p class="win-head mono">{block.heading}</p>
                    <ul>
                      {block.items.map((item) => (
                        <li>{item}</li>
                      ))}
                    </ul>
                  </div>
                ))}
              </div>
            )
          }

          {
            h.ebenezer && (
              <div class="ebenezer">
                <p class="block-head mono">Ebenezer</p>
                {h.ebenezer.map((pair) => (
                  <div class="stone">
                    <p class="stone-before">&ldquo;{pair.before}&rdquo;</p>
                    <p class="stone-after">&ldquo;{pair.after}&rdquo;</p>
                    <p class="stone-when mono">{pair.when}</p>
                  </div>
                ))}
              </div>
            )
          }

          {
            h.themes && (
              <ul class="themes">
                {h.themes.map((t) => (
                  <li>{t}</li>
                ))}
              </ul>
            )
          }

          {
            h.questions && (
              <div class="jumpstart">
                <p class="block-head mono">Jumpstart</p>
                {h.questions.map((q) => (
                  <p class="question">&ldquo;{q}&rdquo;</p>
                ))}
              </div>
            )
          }

          {h.signature && <p class="sig">{h.signature}</p>}
        </div>
      ))
    }
  </div>
</div>

<style>
  .lb {
    position: relative;
    min-height: 440px;
    padding: 36px 32px 40px;
    border-radius: 18px;
    overflow: hidden;
    background:
      radial-gradient(
        ellipse 80% 60% at 50% 18%,
        rgba(243, 189, 118, 0.1),
        transparent 70%
      ),
      linear-gradient(180deg, var(--ink-3), var(--ink-2));
    border: 1px solid var(--border);
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .pills {
    display: flex;
    gap: 6px;
    padding: 4px;
    border-radius: 100px;
    background: rgba(12, 13, 17, 0.55);
    border: 1px solid var(--border);
    margin-bottom: 44px;
    position: relative;
    z-index: 1;
  }
  .pill {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.6px;
    color: var(--muted);
    padding: 7px 14px;
    border-radius: 100px;
    white-space: nowrap;
    background: none;
    border: 1px solid transparent;
    cursor: pointer;
    transition: color 0.2s, background 0.2s, border-color 0.2s;
  }
  .pill:hover {
    color: var(--paper-dim);
  }
  .pill[aria-pressed="true"] {
    color: var(--paper);
    background: rgba(236, 231, 221, 0.1);
    border-color: rgba(236, 231, 221, 0.14);
  }

  .panels {
    width: 100%;
    max-width: 38ch;
    position: relative;
    z-index: 1;
  }
  .panel {
    text-align: center;
    animation: lb-in 0.35s ease;
  }
  .panel[hidden] {
    display: none;
  }
  @keyframes lb-in {
    from {
      opacity: 0;
      transform: translateY(6px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  .kicker {
    font-size: 11px;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: var(--dawn-1);
    margin-bottom: 18px;
  }
  .panel h3 {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: 22px;
    line-height: 1.25;
    color: var(--paper);
    margin-bottom: 16px;
  }
  .body {
    font-family: var(--font-body);
    font-size: 15.5px;
    line-height: 1.65;
    color: var(--paper-dim);
    font-weight: 300;
    margin-bottom: 14px;
    text-align: left;
  }
  .body :global(em) {
    color: var(--gold);
    font-style: italic;
  }

  .block-head {
    font-size: 10px;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: var(--muted);
    margin-bottom: 10px;
    text-align: left;
  }

  .wins {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 20px;
    margin: 22px 0 8px;
    text-align: left;
  }
  .win-head {
    font-size: 10px;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    color: var(--dawn-1);
    margin-bottom: 8px;
  }
  .win-col ul {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  .win-col li {
    font-size: 13.5px;
    line-height: 1.45;
    color: var(--paper-dim);
    font-weight: 300;
    padding-left: 12px;
    position: relative;
  }
  .win-col li::before {
    content: "·";
    position: absolute;
    left: 0;
    color: var(--dawn-1);
  }

  .ebenezer {
    margin: 22px 0 8px;
    text-align: left;
  }
  .stone {
    border-left: 2px solid rgba(243, 189, 118, 0.35);
    padding-left: 16px;
    margin-bottom: 4px;
  }
  .stone-before,
  .stone-after {
    font-family: var(--font-display);
    font-style: italic;
    font-size: 14.5px;
    line-height: 1.45;
    color: var(--paper-dim);
    margin-bottom: 4px;
  }
  .stone-after {
    color: var(--gold);
  }
  .stone-when {
    font-size: 10px;
    letter-spacing: 1px;
    color: var(--muted);
    margin-top: 6px;
  }

  .themes {
    list-style: none;
    margin: 20px 0 4px;
    text-align: left;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .themes li {
    font-family: var(--font-display);
    font-size: 15px;
    font-style: italic;
    color: var(--paper-dim);
    padding-left: 14px;
    position: relative;
  }
  .themes li::before {
    content: "◦";
    position: absolute;
    left: 0;
    color: var(--dawn-1);
  }

  .jumpstart {
    margin: 20px 0 4px;
    text-align: left;
  }
  .question {
    font-family: var(--font-display);
    font-style: italic;
    font-size: 15px;
    line-height: 1.5;
    color: var(--paper-dim);
    margin-bottom: 8px;
  }

  .sig {
    font-family: var(--font-display);
    font-style: italic;
    font-size: 14px;
    color: var(--muted);
    margin-top: 12px;
    text-align: left;
  }

  @media (max-width: 520px) {
    .lb {
      padding: 28px 20px 32px;
      min-height: 400px;
    }
    .pills {
      flex-wrap: wrap;
      justify-content: center;
      border-radius: 16px;
      margin-bottom: 32px;
    }
    .pill {
      font-size: 10px;
      padding: 6px 11px;
    }
    .wins {
      grid-template-columns: 1fr;
      gap: 16px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .panel {
      animation: none;
    }
  }
</style>

<script>
  document.querySelectorAll("[data-looking-back]").forEach((root) => {
    const pills = root.querySelectorAll<HTMLButtonElement>("[data-pill]");
    const panels = root.querySelectorAll<HTMLElement>("[data-panel]");

    pills.forEach((pill) => {
      pill.addEventListener("click", () => {
        const id = pill.dataset.pill;
        if (!id) return;

        pills.forEach((p) => p.setAttribute("aria-pressed", p === pill ? "true" : "false"));
        panels.forEach((panel) => {
          panel.hidden = panel.dataset.panel !== id;
        });
      });
    });
  });
</script>
