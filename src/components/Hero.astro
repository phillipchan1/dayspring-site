---
// Hero — the one dramatic motion moment: the dawn rising over the dark
// page. The radial "dawn", staggered headline fade-ups,
// the blinking verse caret, and a subtle scroll-parallax on the dawn.
// All motion is disabled under prefers-reduced-motion (global.css + guarded JS).
interface Props {
  eyebrow: string;
  /** Headline lines; render the becoming/accent word inside <em>…</em>. */
  lines: string[];
  sub: string;
  verse: { text: string; ref: string };
  primary: { label: string; href: string };
  ghost: { label: string; href: string };
}
const { eyebrow, lines, sub, verse, primary, ghost } = Astro.props;
---

<header>
  <div class="dawn" id="dawn"></div>
  <div class="wrap hero-inner">
    <p class="eyebrow">{eyebrow}</p>
    <h1>
      {lines.map((line) => <span class="l" set:html={line} />)}
    </h1>
    <p class="sub">{sub}</p>
    <p class="verse mono">
      &ldquo;{verse.text}&rdquo; — {verse.ref}<span class="cur"></span>
    </p>
    <div class="actions">
      <a href={primary.href} class="btn btn-primary">{primary.label}</a>
      <a href={ghost.href} class="btn btn-ghost">{ghost.label}</a>
    </div>
  </div>
  <div class="scrollcue mono">scroll ↓</div>
</header>

<style>
  header {
    position: relative;
    min-height: 100vh;
    display: flex;
    align-items: center;
    overflow: hidden;
  }

  /* the dawn — a warm radial sun rising from below the fold */
  .dawn {
    position: absolute;
    left: 50%;
    bottom: -32vh;
    transform: translateX(-50%) scale(0.6);
    width: 140vw;
    height: 120vh;
    border-radius: 50%;
    background: radial-gradient(
      ellipse at center,
      rgba(243, 189, 118, 0.5) 0%,
      rgba(232, 145, 124, 0.3) 28%,
      rgba(197, 106, 110, 0.13) 48%,
      rgba(12, 13, 17, 0) 70%
    );
    filter: blur(8px);
    opacity: 0;
    animation:
      rise 2.8s cubic-bezier(0.16, 0.7, 0.2, 1) 0.2s forwards,
      drift 14s ease-in-out 3s infinite alternate;
  }
  @keyframes rise {
    to {
      opacity: 1;
      transform: translateX(-50%) scale(1);
    }
  }
  @keyframes drift {
    from {
      transform: translateX(-50%) scale(1);
    }
    to {
      transform: translateX(-52%) scale(1.06);
    }
  }

  @keyframes fade {
    to {
      opacity: 1;
    }
  }

  .hero-inner {
    position: relative;
    z-index: 2;
    padding-top: 60px;
  }

  .eyebrow {
    font-family: var(--font-mono);
    font-size: 12.5px;
    letter-spacing: 3px;
    text-transform: uppercase;
    color: var(--dawn-1);
    margin-bottom: 30px;
    opacity: 0;
    animation: up 0.9s ease 0.3s forwards;
  }

  h1 {
    font-family: var(--font-display);
    font-weight: 300;
    font-size: clamp(46px, 8.5vw, 108px);
    line-height: 0.98;
    letter-spacing: -1.5px;
    max-width: 14ch;
    margin-bottom: 30px;
  }
  h1 .l {
    display: block;
    opacity: 0;
    transform: translateY(26px);
    animation: up 1.1s cubic-bezier(0.16, 0.7, 0.2, 1) forwards;
  }
  h1 .l:nth-child(1) {
    animation-delay: 0.45s;
  }
  h1 .l:nth-child(2) {
    animation-delay: 0.62s;
  }
  h1 :global(em) {
    font-style: italic;
    font-weight: 400;
    background: linear-gradient(
      100deg,
      var(--dawn-1),
      var(--dawn-2) 60%,
      var(--dawn-3)
    );
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .sub {
    font-size: clamp(17px, 2vw, 20px);
    color: var(--paper-dim);
    max-width: 46ch;
    font-weight: 300;
    line-height: 1.55;
    margin-bottom: 34px;
    opacity: 0;
    animation: up 1s ease 0.9s forwards;
  }

  .verse {
    font-size: 13px;
    color: var(--muted);
    margin-bottom: 42px;
    opacity: 0;
    animation: up 1s ease 1.15s forwards;
    letter-spacing: 0.2px;
  }
  .verse .cur {
    display: inline-block;
    width: 8px;
    height: 15px;
    vertical-align: -2px;
    background: var(--dawn-1);
    margin-left: 3px;
    animation: blink 1.1s steps(1) infinite;
  }
  @keyframes blink {
    50% {
      opacity: 0;
    }
  }

  .actions {
    display: flex;
    gap: 16px;
    align-items: center;
    flex-wrap: wrap;
    opacity: 0;
    animation: up 1s ease 1.35s forwards;
  }

  @keyframes up {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .scrollcue {
    position: absolute;
    bottom: 28px;
    left: 50%;
    transform: translateX(-50%);
    z-index: 2;
    font-size: 11px;
    letter-spacing: 2px;
    color: var(--muted);
    text-transform: uppercase;
    opacity: 0;
    animation: fade 1.5s ease 2s forwards;
  }

  /* Under reduced motion, the dawn is pinned visible (no rise). */
  @media (prefers-reduced-motion: reduce) {
    .dawn {
      opacity: 1;
      transform: translateX(-50%) scale(1);
    }
    .eyebrow,
    h1 .l,
    .sub,
    .verse,
    .actions,
    .scrollcue {
      opacity: 1;
      transform: none;
    }
  }
</style>

<script>
  // Subtle scroll parallax on the dawn — skipped under reduced motion.
  const dawn = document.getElementById("dawn");
  const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  if (dawn && !reduce) {
    addEventListener(
      "scroll",
      () => {
        dawn.style.marginBottom = window.scrollY * 0.15 + "px";
      },
      { passive: true },
    );
  }
</script>
