---
// EditorMock — a native HTML/CSS recreation of the Dayspring editor:
// window chrome, focus-mode line dimming, a blinking caret on the active
// line, and a theme-swatch row. Not a screenshot — real markup.
interface Theme {
  name: string;
  /** swatch color */
  color: string;
}
interface Props {
  /** Filename shown in the chrome (e.g. "march-14.md"). */
  file: string;
  /** Extra meta crumbs joined by a dot separator (e.g. ["Focus mode", "JetBrains Mono"]). */
  meta?: string[];
  /** Date label above the entry. */
  day: string;
  /** Entry lines. Dimmed except the active one (focus mode). */
  lines: string[];
  /** Index of the active (undimmed) line. Defaults to the last line. */
  activeLine?: number;
  /** Show the blinking caret after the active line. */
  caret?: boolean;
  /** Theme swatch row. */
  themes?: Theme[];
  class?: string;
}
const {
  file,
  meta = [],
  day,
  lines,
  activeLine = lines.length - 1,
  caret = true,
  themes = [],
  class: className = "",
} = Astro.props;
---

<div class:list={["editor-frame", className]}>
  <div class="ef-bar">
    <div class="ef-dots" aria-hidden="true"><i></i><i></i><i></i></div>
    <div class="ef-meta">
      {file}
      {
        meta.map((m) => (
          <>
            <span class="sep">·</span>
            {m}
          </>
        ))
      }
    </div>
  </div>

  <div class="ef-body">
    <div class="day">{day}</div>
    {
      lines.map((line, i) => (
        <div class:list={["line", { active: i === activeLine }]}>
          {line}
          {caret && i === activeLine && <span class="caret" />}
        </div>
      ))
    }
  </div>

  {
    themes.length > 0 && (
      <div class="ef-foot">
        <span class="lbl">Theme</span>
        {themes.map((t) => (
          <span class="sw">
            <i style={`background:${t.color}`} />
            {t.name}
          </span>
        ))}
      </div>
    )
  }
</div>

<style>
  .editor-frame {
    position: relative;
    z-index: 1;
    background: #0f1117;
    border: 1px solid var(--border);
    border-radius: 14px;
    overflow: hidden;
    box-shadow: 0 50px 100px -45px rgba(0, 0, 0, 0.9);
  }

  .ef-bar {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 13px 16px;
    border-bottom: 1px solid var(--border);
    background: rgba(255, 255, 255, 0.015);
  }
  .ef-dots {
    display: flex;
    gap: 7px;
  }
  .ef-dots i {
    width: 11px;
    height: 11px;
    border-radius: 50%;
    display: block;
    opacity: 0.6;
  }
  .ef-dots i:nth-child(1) {
    background: #e8917c;
  }
  .ef-dots i:nth-child(2) {
    background: #f3bd76;
  }
  .ef-dots i:nth-child(3) {
    background: #9fcf8f;
  }
  .ef-meta {
    font-family: var(--font-mono);
    font-size: 11.5px;
    color: var(--muted);
    letter-spacing: 0.4px;
  }
  .ef-meta .sep {
    opacity: 0.4;
    margin: 0 8px;
  }

  .ef-body {
    padding: 36px 42px 32px;
    font-family: var(--font-body);
    font-size: 18px;
    line-height: 1.9;
  }
  .ef-body .day {
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 1px;
    color: var(--dawn-1);
    margin-bottom: 16px;
    text-transform: uppercase;
  }
  /* focus mode: inactive lines dimmed, active line full paper */
  .ef-body .line {
    color: rgba(236, 231, 221, 0.3);
    transition: color 0.6s;
  }
  .ef-body .line.active {
    color: var(--paper);
  }
  .ef-body .caret {
    display: inline-block;
    width: 8px;
    height: 18px;
    vertical-align: -3px;
    background: var(--dawn-1);
    margin-left: 2px;
    animation: blink 1.1s steps(1) infinite;
  }
  @keyframes blink {
    50% {
      opacity: 0;
    }
  }

  .ef-foot {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 12px 16px;
    flex-wrap: wrap;
    border-top: 1px solid var(--border);
    background: rgba(255, 255, 255, 0.015);
  }
  .ef-foot .lbl {
    font-family: var(--font-mono);
    font-size: 10.5px;
    color: var(--muted);
    letter-spacing: 1px;
    text-transform: uppercase;
  }
  .sw {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--muted);
  }
  .sw i {
    width: 13px;
    height: 13px;
    border-radius: 4px;
    display: block;
    border: 1px solid rgba(255, 255, 255, 0.12);
  }

  @media (max-width: 600px) {
    .ef-body {
      padding: 24px 22px;
      font-size: 16px;
    }
  }
</style>
