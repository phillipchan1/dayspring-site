---
// AppMock — a native HTML/CSS recreation of the actual Dayspring desktop app:
// a left icon rail, the entries sidebar (brand, search, list with an active
// row), and the editor pane (status bar, a gold entry title, prose with a
// blinking caret) plus the "+" FAB. Not a screenshot — real markup, so it
// stays crisp and themed to First Light. Content is tasteful marketing copy.
//
// Collapses to the editor pane only in narrow containers (container query),
// so it reads well in a half-width feature column and on mobile.
import Mark from "./Mark.astro";

interface Entry {
  title: string;
  meta: string; // e.g. "Mar 14 · 120 w"
  active?: boolean;
}
interface Props {
  brand?: string;
  count?: string; // "ENTRIES · 511"
  entries?: Entry[];
  open?: {
    date: string; // editor top-left, e.g. "march 14"
    status: string; // e.g. "112 words · saved just now · synced"
    title: string; // gold entry title
    body: string[]; // paragraphs
  };
  class?: string;
}

const {
  brand = "Dayspring",
  count = "Entries · 511",
  entries = [
    { title: "Hard conversation with Marcus", meta: "Mar 14 · 120 w", active: true },
    { title: "Morning, before the house woke", meta: "Mar 13 · 240 w" },
    { title: "What I keep circling back to", meta: "Mar 11 · 90 w" },
    { title: "On the long drive home", meta: "Mar 9 · 310 w" },
    { title: "Gratitude, even today", meta: "Mar 8 · 75 w" },
    { title: "A prayer I almost didn't write", meta: "Mar 6 · 180 w" },
    { title: "Here at the table", meta: "Mar 3 · 60 w" },
    { title: "Untitled", meta: "Mar 2 · 0 w" },
  ],
  open = {
    date: "march 14",
    status: "112 words · saved just now · synced",
    title: "Hard conversation with Marcus",
    body: [
      "I went in defensive and left grateful — not sure when that shifted.",
      "I've been praying about patience for months now. Maybe this was an answer I almost walked past.",
    ],
  },
  class: className = "",
} = Astro.props;
---

<div class:list={["appw", className]}>
  <div class="traffic" aria-hidden="true"><i></i><i></i><i></i></div>

  <div class="appw-main">
    {/* far-left icon rail */}
    <nav class="rail" aria-hidden="true">
      <span class="rail-logo">
        <Mark size={20} />
      </span>
      <span class="rail-item active">
        <svg viewBox="0 0 24 24" width="17" height="17"><path d="M4 6h16M4 12h16M4 18h16" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" /></svg>
        <em>Entries</em>
      </span>
      <span class="rail-item">
        <svg viewBox="0 0 24 24" width="17" height="17"><path d="M3 12a9 9 0 1 0 3-6.7M3 4v4h4" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" /></svg>
        <em>Looking back</em>
      </span>
      <span class="rail-item settings">
        <svg viewBox="0 0 24 24" width="17" height="17"><path d="M4 7h10M18 7h2M4 17h2M10 17h10M14 4v6M8 14v6" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" /></svg>
        <em>Settings</em>
      </span>
    </nav>

    {/* entries sidebar */}
    <aside class="side">
      <div class="side-brand">{brand}</div>
      <div class="side-search">Search entries…</div>
      <div class="side-count">{count}</div>
      <ul class="side-list">
        {
          entries.map((e) => (
            <li class:list={["entry", { active: e.active }]}>
              <span class="e-title">{e.title}</span>
              <span class="e-meta">{e.meta}</span>
            </li>
          ))
        }
      </ul>
    </aside>

    {/* editor pane */}
    <section class="editor">
      <div class="ed-top">
        <span class="ed-date">{open.date}</span>
        <span class="ed-status">
          <span class="dot" aria-hidden="true"></span>{open.status}
          <span class="ed-focus">focus</span>
        </span>
      </div>
      <h3 class="ed-title">{open.title}</h3>
      <div class="ed-body">
        {
          open.body.map((p, i) => (
            <p>
              {p}
              {i === open.body.length - 1 && <span class="caret" />}
            </p>
          ))
        }
      </div>
      <span class="fab" aria-hidden="true">+</span>
    </section>
  </div>
</div>

<style>
  .appw {
    container-type: inline-size;
    position: relative;
    background: #0f1117;
    border: 1px solid var(--border);
    border-radius: 14px;
    overflow: hidden;
    box-shadow: 0 50px 100px -45px rgba(0, 0, 0, 0.9);
  }

  /* macOS traffic lights — First Light tinted */
  .traffic {
    position: absolute;
    top: 15px;
    left: 16px;
    z-index: 3;
    display: flex;
    gap: 7px;
  }
  .traffic i {
    width: 11px;
    height: 11px;
    border-radius: 50%;
    opacity: 0.65;
  }
  .traffic i:nth-child(1) { background: #e8917c; }
  .traffic i:nth-child(2) { background: #f3bd76; }
  .traffic i:nth-child(3) { background: #9fcf8f; }

  .appw-main {
    display: flex;
    min-height: 460px;
  }

  /* ---- rail ---- */
  .rail {
    flex: none;
    width: 64px;
    border-right: 1px solid var(--border);
    padding: 46px 0 16px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 20px;
  }
  .rail-logo {
    display: inline-flex;
    margin-bottom: 6px;
  }
  .rail-item {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 5px;
    color: var(--muted);
  }
  .rail-item em {
    font-family: var(--font-mono);
    font-size: 7.5px;
    letter-spacing: 0.5px;
    text-transform: uppercase;
    font-style: normal;
    text-align: center;
    line-height: 1.2;
    max-width: 52px;
  }
  .rail-item.active {
    color: var(--dawn-1);
  }
  .rail-item.settings {
    margin-top: auto;
  }

  /* ---- sidebar ---- */
  .side {
    flex: none;
    width: 232px;
    border-right: 1px solid var(--border);
    padding: 42px 16px 16px;
    overflow: hidden;
  }
  .side-brand {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 18px;
    color: var(--paper);
    margin-bottom: 16px;
  }
  .side-search {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--muted);
    border: 1px solid var(--border);
    border-radius: 9px;
    padding: 9px 12px;
    margin-bottom: 18px;
  }
  .side-count {
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    color: var(--muted);
    margin-bottom: 14px;
  }
  .side-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 2px;
  }
  .entry {
    display: flex;
    flex-direction: column;
    gap: 3px;
    padding: 9px 12px;
    margin: 0 -12px;
    border-left: 2px solid transparent;
  }
  .entry.active {
    background: rgba(243, 189, 118, 0.07);
    border-left-color: var(--dawn-1);
  }
  .e-title {
    font-family: var(--font-body);
    font-size: 14px;
    color: var(--paper-dim);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .entry.active .e-title {
    color: var(--paper);
  }
  .e-meta {
    font-family: var(--font-mono);
    font-size: 10.5px;
    color: var(--muted);
    letter-spacing: 0.3px;
  }

  /* ---- editor ---- */
  .editor {
    position: relative;
    flex: 1;
    padding: 16px 38px 38px;
    min-width: 0;
  }
  .ed-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    font-family: var(--font-mono);
    font-size: 11.5px;
    color: var(--muted);
    margin-bottom: 44px;
  }
  .ed-status {
    display: inline-flex;
    align-items: center;
    gap: 7px;
  }
  .ed-status .dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--dawn-1);
    box-shadow: 0 0 8px 0 rgba(243, 189, 118, 0.6);
  }
  .ed-focus {
    color: var(--paper-dim);
    margin-left: 6px;
  }
  .ed-title {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: clamp(22px, 3.2vw, 30px);
    letter-spacing: -0.4px;
    line-height: 1.1;
    color: var(--dawn-1);
    margin-bottom: 26px;
  }
  .ed-body p {
    font-family: var(--font-body);
    font-size: 17px;
    line-height: 1.75;
    color: var(--paper);
    font-weight: 300;
    margin-bottom: 14px;
    max-width: 60ch;
  }
  .ed-body .caret {
    display: inline-block;
    width: 8px;
    height: 18px;
    vertical-align: -3px;
    background: var(--dawn-1);
    margin-left: 2px;
    animation: appw-blink 1.1s steps(1) infinite;
  }
  @keyframes appw-blink {
    50% { opacity: 0; }
  }

  .fab {
    position: absolute;
    right: 22px;
    bottom: 22px;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-body);
    font-size: 26px;
    line-height: 1;
    color: var(--ink);
    background: radial-gradient(circle at 35% 30%, var(--dawn-1), var(--dawn-3));
    box-shadow: 0 10px 26px -6px rgba(243, 189, 118, 0.55);
  }

  /* narrow container (half-width feature column, mobile): editor only */
  @container (max-width: 600px) {
    .rail,
    .side {
      display: none;
    }
    .editor {
      padding: 18px 22px 30px;
    }
    .ed-top {
      margin-bottom: 28px;
    }
  }
</style>
