---
// SlashCommandsMock — in-flow slash palette + follow-up panels matching the app.
interface Command {
  id: string;
  label: string;
  hint: string;
  blurb: string;
}
interface Props {
  commands: Command[];
  editorLines: string[];
  class?: string;
}
const { commands, editorLines, class: className = "" } = Astro.props;
const defaultId = commands[0]?.id ?? "scripture";

const scripturePassages = [
  {
    ref: "James 1:19",
    text: "Let every person be quick to hear, slow to speak, slow to anger…",
  },
  {
    ref: "Colossians 3:12",
    text: "Put on then, as God's chosen ones, holy and beloved, compassionate hearts, kindness…",
  },
  {
    ref: "Philippians 4:6",
    text: "Do not be anxious about anything, but in everything by prayer and supplication…",
  },
];

const prayTypes = ["Intercession", "Gratitude", "Petition", "Praise"];
const remindHorizons = [
  { id: "1w", label: "1 week", sub: "Next week" },
  { id: "1m", label: "1 month", sub: "A month from now" },
  { id: "3m", label: "3 months", sub: "A season from now" },
  { id: "1y", label: "a year", sub: "Some things take a year to see clearly.", hero: true },
];
---

<div class:list={["slash-mock", className]} data-slash-mock>
  <div class="mock-grid">
    <div class="editor-crop">
      <p class="ed-date mono">march 14</p>
      <h3 class="ed-title">Hard conversation with Marcus</h3>
      <div class="ed-body">
        {
          editorLines.map((line, i) => (
            <p>
              {line}
              {i === editorLines.length - 1 && (
                <>
                  <span class="slash-typed">/</span>
                  <span class="caret" aria-hidden="true" />
                </>
              )}
            </p>
          ))
        }
      </div>
    </div>

    <div class="tools-col">
      <nav class="slash-palette glass-panel" role="listbox" aria-label="Commands">
        <div class="glass-glow" aria-hidden="true"></div>
        {
          commands.map((cmd, i) => (
            <button
              type="button"
              role="option"
              class="palette-item"
              data-cmd={cmd.id}
              aria-selected={cmd.id === defaultId ? "true" : "false"}
            >
              <span class="palette-label">{cmd.label}</span>
              <span class="palette-hint">{cmd.hint}</span>
            </button>
          ))
        }
      </nav>

      <div class="followups">
        {
          commands.map((cmd) => (
            <div
              class="followup glass-panel"
              data-panel={cmd.id}
              hidden={cmd.id !== defaultId}
            >
              <div class="glass-glow" aria-hidden="true"></div>
              <p class="cmd-blurb">{cmd.blurb}</p>

              {cmd.id === "scripture" && (
                <div class="panel-scripture">
                  <label class="sr-only" for="scr-search">Scripture search</label>
                  <input
                    id="scr-search"
                    type="text"
                    class="mock-input"
                    value="patience in hard conversations"
                    readonly
                    tabindex="-1"
                  />
                  <ul class="passages">
                    {
                      scripturePassages.slice(0, 2).map((p) => (
                        <li>
                          <span class="passage-ref mono">{p.ref}</span>
                          <span class="passage-text">{p.text}</span>
                        </li>
                      ))
                    }
                  </ul>
                </div>
              )}

              {cmd.id === "pray" && (
                <div class="panel-pray">
                  <label class="field-label mono">prayer</label>
                  <textarea
                    class="mock-textarea"
                    rows={2}
                    readonly
                    tabindex="-1"
                    value="What are you bringing…"
                  />
                  <div class="chips" role="group" aria-label="Prayer type (optional)">
                    {prayTypes.map((t, i) => (
                      <span class:list={["chip", { active: i === 0 }]}>{t}</span>
                    ))}
                  </div>
                  <p class="panel-hint mono">⌘ enter to keep · esc to cancel</p>
                </div>
              )}

              {cmd.id === "sense" && (
                <div class="panel-sense">
                  <p class="sense-title">I sense God is saying…</p>
                  <textarea
                    class="mock-textarea"
                    rows={2}
                    readonly
                    tabindex="-1"
                    value="Stay — don't rush to fix it."
                  />
                </div>
              )}

              {cmd.id === "remind" && (
                <div class="panel-remind">
                  <p class="remind-title">Return to this</p>
                  <div class="horizons">
                    {
                      remindHorizons.map((h) => (
                        <button
                          type="button"
                          class:list={["horizon", { hero: h.hero }]}
                          disabled
                        >
                          <span class="h-label">{h.label}</span>
                          <span class="h-sub">{h.sub}</span>
                        </button>
                      ))
                    }
                  </div>
                </div>
              )}
            </div>
          ))
        }
      </div>
    </div>
  </div>
</div>

<style>
  .slash-mock {
    position: relative;
    border-radius: 18px;
    overflow: hidden;
    background: linear-gradient(165deg, var(--ink-3), var(--ink-2));
    border: 1px solid var(--border);
    padding: 28px 28px 30px;
  }

  .mock-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 24px;
    align-items: start;
  }

  .editor-crop {
    position: relative;
    padding-top: 4px;
  }

  .tools-col {
    display: flex;
    flex-direction: column;
    gap: 10px;
    min-width: 0;
  }

  .ed-date {
    font-size: 11px;
    letter-spacing: 1px;
    text-transform: lowercase;
    color: var(--muted);
    margin-bottom: 10px;
  }
  .ed-title {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: 20px;
    color: var(--dawn-1);
    margin-bottom: 16px;
  }
  .ed-body p {
    font-size: 15.5px;
    line-height: 1.65;
    color: var(--paper-dim);
    font-weight: 300;
    margin-bottom: 10px;
  }
  .slash-typed {
    font-family: var(--font-mono);
    color: var(--dawn-1);
  }
  .caret {
    display: inline-block;
    width: 7px;
    height: 14px;
    vertical-align: -2px;
    background: var(--dawn-1);
    margin-left: 1px;
    animation: blink 1.1s steps(1) infinite;
  }
  @keyframes blink {
    50% {
      opacity: 0;
    }
  }

  .palette-anchor {
    position: relative;
  }

  .glass-panel {
    position: relative;
    overflow: hidden;
    background: rgba(18, 19, 25, 0.72);
    backdrop-filter: blur(18px) saturate(1.05);
    -webkit-backdrop-filter: blur(18px) saturate(1.05);
    border: 1px solid rgba(236, 231, 221, 0.1);
    border-radius: 14px;
    box-shadow:
      0 8px 32px -8px rgba(0, 0, 0, 0.45),
      inset 0 1px 0 rgba(236, 231, 221, 0.06);
  }
  .glass-glow {
    position: absolute;
    top: -38%;
    right: -22%;
    width: 58%;
    height: 78%;
    background: radial-gradient(
      circle at 45% 45%,
      rgba(243, 189, 118, 0.14),
      transparent 68%
    );
    filter: blur(32px);
    pointer-events: none;
    z-index: 0;
  }

  .slash-palette {
    padding: 0.3rem;
    width: 100%;
    z-index: 2;
  }
  .palette-item {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    width: 100%;
    padding: 0.55rem 0.75rem;
    border-radius: 10px;
    border: none;
    background: transparent;
    text-align: left;
    cursor: pointer;
    transition: background 0.2s;
    position: relative;
    z-index: 1;
  }
  .palette-item:hover,
  .palette-item[aria-selected="true"] {
    background: rgba(236, 231, 221, 0.08);
  }
  .palette-label {
    font-family: var(--font-mono);
    font-size: 0.82rem;
    color: var(--paper);
    letter-spacing: 0.01em;
  }
  .palette-hint {
    font-size: 0.77rem;
    color: var(--muted);
    font-family: var(--font-body);
  }

  .followups {
    flex: 1;
    min-height: 0;
  }
  .followup {
    padding: 16px 18px;
    animation: panel-in 0.35s ease;
    position: relative;
    z-index: 1;
  }
  .followup[hidden] {
    display: none;
  }
  @keyframes panel-in {
    from {
      opacity: 0;
      transform: translateY(6px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  .cmd-blurb {
    font-size: 13px;
    color: var(--paper-dim);
    font-weight: 300;
    line-height: 1.5;
    margin-bottom: 12px;
    position: relative;
    z-index: 1;
  }

  .mock-input,
  .mock-textarea {
    width: 100%;
    font-family: var(--font-body);
    font-size: 14.5px;
    color: var(--paper);
    background: rgba(12, 13, 17, 0.5);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 10px 12px;
    resize: none;
    position: relative;
    z-index: 1;
  }
  .mock-textarea {
    line-height: 1.5;
    color: var(--muted);
  }

  .passages {
    list-style: none;
    margin-top: 10px;
    display: flex;
    flex-direction: column;
    gap: 10px;
    position: relative;
    z-index: 1;
  }
  .passages li {
    padding-left: 12px;
    border-left: 2px solid rgba(243, 189, 118, 0.35);
  }
  .passage-ref {
    display: block;
    font-size: 10px;
    letter-spacing: 1px;
    text-transform: uppercase;
    color: var(--dawn-1);
    margin-bottom: 4px;
  }
  .passage-text {
    font-size: 13.5px;
    line-height: 1.5;
    color: var(--paper-dim);
    font-style: italic;
  }

  .field-label {
    font-size: 10px;
    letter-spacing: 1.5px;
    text-transform: lowercase;
    color: var(--muted);
    margin-bottom: 6px;
    display: block;
    position: relative;
    z-index: 1;
  }
  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-top: 10px;
    position: relative;
    z-index: 1;
  }
  .chip {
    font-family: var(--font-mono);
    font-size: 11px;
    padding: 5px 10px;
    border-radius: 100px;
    border: 1px solid var(--border);
    color: var(--muted);
  }
  .chip.active {
    color: var(--paper);
    border-color: rgba(243, 189, 118, 0.4);
    background: rgba(243, 189, 118, 0.08);
  }
  .panel-hint {
    font-size: 10px;
    letter-spacing: 0.5px;
    color: var(--muted);
    margin-top: 10px;
    position: relative;
    z-index: 1;
  }

  .sense-title,
  .remind-title {
    font-family: var(--font-display);
    font-size: 16px;
    color: var(--paper);
    margin-bottom: 10px;
    position: relative;
    z-index: 1;
  }

  .horizons {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 8px;
    position: relative;
    z-index: 1;
  }
  .horizon {
    text-align: left;
    padding: 10px 12px;
    border-radius: 10px;
    border: 1px solid var(--border);
    background: rgba(12, 13, 17, 0.4);
    cursor: default;
  }
  .horizon.hero {
    grid-column: 1 / -1;
    border-color: rgba(243, 189, 118, 0.35);
  }
  .h-label {
    display: block;
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--paper);
    margin-bottom: 2px;
  }
  .h-sub {
    display: block;
    font-size: 11px;
    color: var(--muted);
    line-height: 1.4;
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  @media (max-width: 640px) {
    .mock-grid {
      grid-template-columns: 1fr;
      gap: 20px;
    }
    .horizons {
      grid-template-columns: 1fr;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .followup {
      animation: none;
    }
    .caret {
      animation: none;
    }
  }
</style>

<script>
  document.querySelectorAll("[data-slash-mock]").forEach((root) => {
    const items = root.querySelectorAll<HTMLButtonElement>(".palette-item[data-cmd]");
    const panels = root.querySelectorAll<HTMLElement>(".followup[data-panel]");

    const select = (id: string) => {
      items.forEach((btn) => {
        btn.setAttribute("aria-selected", btn.dataset.cmd === id ? "true" : "false");
      });
      panels.forEach((panel) => {
        panel.hidden = panel.dataset.panel !== id;
      });
    };

    items.forEach((btn, idx) => {
      btn.addEventListener("click", () => {
        const id = btn.dataset.cmd;
        if (id) select(id);
      });

      btn.addEventListener("mouseenter", () => {
        const id = btn.dataset.cmd;
        if (id) select(id);
      });
    });

    root.addEventListener("keydown", (e) => {
      const keys = ["ArrowDown", "ArrowUp", "Enter", "Tab"];
      if (!keys.includes(e.key)) return;

      const list = Array.from(items);
      const current = list.findIndex((b) => b.getAttribute("aria-selected") === "true");
      if (current < 0) return;

      e.preventDefault();
      let next = current;
      if (e.key === "ArrowDown") next = Math.min(current + 1, list.length - 1);
      if (e.key === "ArrowUp") next = Math.max(current - 1, 0);
      if (e.key === "Enter" || e.key === "Tab") next = current;

      const id = list[next]?.dataset.cmd;
      if (id) select(id);
      list[next]?.focus();
    });
  });
</script>
