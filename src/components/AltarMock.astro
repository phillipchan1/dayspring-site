---
// AltarMock — a field of cairns. Each recurring prayer is a heap of stones
// whose height is how often you've returned; a lit capstone means God met you
// there. A place of remembrance, not a queue of requests.
interface Cairn {
  label: string;
  stones: number;
  lit?: boolean;
  movement?: string;
  span?: string;
}
interface Props {
  subtitle?: string;
  cairns: Cairn[];
  note?: string;
  class?: string;
}
const {
  subtitle = "Thus far the Lord has helped",
  cairns,
  note,
  class: className = "",
} = Astro.props;
---

<div class:list={["altar-mock", className]}>
  <header class="altar-head">
    <h3 class="altar-title">Altar</h3>
    <p class="altar-sub mono">{subtitle}</p>
  </header>

  <div class="altar-field" role="img" aria-label="A field of prayer cairns">
    {
      cairns.map((c) => (
        <div class:list={["cairn", { lit: c.lit }]}>
          <div class="stones">
            {Array.from({ length: c.stones }).map((_, i) => (
              <span
                class:list={[
                  "stone",
                  { cap: c.lit && i === c.stones - 1 },
                ]}
              />
            ))}
          </div>
          <p class="cairn-label">{c.label}</p>
          {c.movement && <p class="cairn-move mono">{c.movement}</p>}
          {c.span && <p class="cairn-span mono">{c.span}</p>}
        </div>
      ))
    }
  </div>

  {note && <p class="altar-note">{note}</p>}
</div>

<style>
  .altar-mock {
    border-radius: 18px;
    background: linear-gradient(180deg, var(--ink-3) 0%, var(--ink-2) 70%);
    border: 1px solid var(--border);
    padding: 24px 24px 26px;
    max-width: 100%;
    overflow: hidden;
  }

  .altar-head {
    margin-bottom: 26px;
  }
  .altar-title {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(1.5rem, 3vw, 1.85rem);
    color: var(--paper);
    letter-spacing: 0.01em;
    margin: 0;
  }
  .altar-sub {
    margin: 7px 0 0;
    font-size: 11px;
    letter-spacing: 1.4px;
    text-transform: uppercase;
    color: var(--dawn-1);
  }

  /* the field — cairns sit on a shared baseline */
  .altar-field {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 10px;
    min-height: 168px;
    padding-bottom: 4px;
    border-bottom: 1px solid var(--border);
  }
  .cairn {
    flex: 1 1 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 4px;
    min-width: 0;
  }
  /* stack stones bottom-up: widest at the base, tapering toward the top */
  .stones {
    display: flex;
    flex-direction: column-reverse;
    align-items: center;
    gap: 3px;
    margin-bottom: 8px;
  }
  .stone {
    display: block;
    width: 30px;
    height: 9px;
    border-radius: 5px;
    background: rgba(214, 211, 209, 0.16);
    border: 1px solid rgba(214, 211, 209, 0.1);
  }
  /* gentle taper — upper stones narrow slightly */
  .stone:nth-child(2) {
    width: 27px;
  }
  .stone:nth-child(3) {
    width: 25px;
  }
  .stone:nth-child(4) {
    width: 23px;
  }
  .stone:nth-child(n + 5) {
    width: 21px;
  }
  /* the capstone — His meeting you */
  .stone.cap {
    background: var(--gold);
    border-color: var(--gold);
    box-shadow:
      0 0 10px rgba(243, 189, 118, 0.6),
      0 0 22px rgba(243, 189, 118, 0.35);
  }

  .cairn-label {
    font-size: 12.5px;
    color: var(--paper-dim);
    font-weight: 300;
    text-align: center;
    line-height: 1.2;
  }
  .cairn-move {
    font-size: 9.5px;
    letter-spacing: 0.4px;
    color: var(--dawn-1);
    text-align: center;
  }
  .cairn-span {
    font-size: 9px;
    letter-spacing: 0.3px;
    color: var(--muted);
    text-align: center;
  }

  .altar-note {
    margin: 18px 0 0;
    font-family: var(--font-display);
    font-style: italic;
    font-weight: 300;
    font-size: 14px;
    color: var(--muted);
    text-align: center;
    line-height: 1.5;
  }

  @media (max-width: 520px) {
    .stone {
      width: 24px;
    }
    .cairn-move,
    .cairn-span {
      display: none;
    }
  }
</style>
