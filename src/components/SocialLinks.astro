---
// Icon row for public profiles. Inline SVGs — same approach as Nav / mocks.
import { socialLinks } from "../content/site";
---

<nav class="social" aria-label="Social">
  {
    socialLinks.map((link) => (
      <a
        href={link.href}
        target="_blank"
        rel="noopener"
        aria-label={link.ariaLabel}
      >
        {link.name === "Instagram" && (
          <svg
            viewBox="0 0 24 24"
            width="20"
            height="20"
            aria-hidden="true"
            fill="none"
            stroke="currentColor"
            stroke-width="1.6"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <rect x="3" y="3" width="18" height="18" rx="5" />
            <circle cx="12" cy="12" r="4" />
            <circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none" />
          </svg>
        )}
      </a>
    ))
  }
</nav>

<style>
  .social {
    display: flex;
    gap: 18px;
    justify-content: center;
    align-items: center;
  }
  .social a {
    display: inline-flex;
    color: var(--muted);
    text-decoration: none;
    transition: color 0.25s;
  }
  .social a:hover {
    color: var(--paper);
  }
</style>
