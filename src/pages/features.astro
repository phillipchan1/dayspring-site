---
import Base from "../layouts/Base.astro";
import SectionReveal from "../components/SectionReveal.astro";
import EditorMock from "../components/EditorMock.astro";
import LetterCard from "../components/LetterCard.astro";
import FormationMock from "../components/FormationMock.astro";
import { featuresIntro, deepDives } from "../content/features";
import { editor, yearInReview, formation } from "../content/home";
---

<Base
  title="Features"
  description="A page worth returning to, a reflection that reads like a letter, and a quiet eye on the formation that never makes it onto a to-do list."
  path="/features"
>
  <section class="f-intro">
    <SectionReveal class="wrap">
      <p class="eyebrow mono">{featuresIntro.eyebrow}</p>
      <h1 set:html={featuresIntro.heading} />
      <p class="lead">{featuresIntro.lead}</p>
    </SectionReveal>
  </section>

  {
    deepDives.map((dive, i) => (
      <section class:list={["deepdive", { alt: i % 2 === 1 }]} id={dive.id}>
        <div class="wrap">
          <div class="grid">
            <SectionReveal class="copy">
              <p class="tag mono">{dive.tag}</p>
              <h2 set:html={dive.heading} />
              <p class="lead">{dive.lead}</p>
              <ul class="points">
                {dive.points.map((p) => (
                  <li>
                    <span class="p-title">{p.title}</span>
                    <span class="p-body">{p.body}</span>
                  </li>
                ))}
              </ul>
            </SectionReveal>

            <SectionReveal class="visual">
              {dive.mock === "editor" && (
                <EditorMock
                  file={editor.mock.file}
                  meta={editor.mock.meta}
                  day={editor.mock.day}
                  lines={editor.mock.lines}
                  themes={editor.mock.themes}
                />
              )}
              {dive.mock === "letter" && (
                <LetterCard
                  kind={yearInReview.letter.kind}
                  period={yearInReview.letter.period}
                  title={yearInReview.letter.title}
                  paragraphs={yearInReview.letter.paragraphs}
                  signature={yearInReview.letter.signature}
                />
              )}
              {dive.mock === "formation" && (
                <FormationMock
                  label={formation.mock.label}
                  season={formation.mock.season}
                  qualities={formation.mock.qualities}
                />
              )}
            </SectionReveal>
          </div>
        </div>
      </section>
    ))
  }
</Base>

<style>
  /* ---- intro ---- */
  .f-intro {
    padding: 200px 0 60px;
    text-align: center;
  }
  .f-intro .eyebrow {
    font-size: 12.5px;
    letter-spacing: 3px;
    text-transform: uppercase;
    color: var(--dawn-1);
    margin-bottom: 26px;
  }
  .f-intro h1 {
    font-family: var(--font-display);
    font-weight: 300;
    font-size: clamp(40px, 7vw, 76px);
    line-height: 1.02;
    letter-spacing: -1.5px;
    margin: 0 auto 24px;
    max-width: 14ch;
  }
  .f-intro h1 :global(em) {
    font-style: italic;
    color: var(--gold);
  }
  .f-intro .lead {
    font-size: 19px;
    color: var(--paper-dim);
    font-weight: 300;
    line-height: 1.6;
    max-width: 52ch;
    margin: 0 auto;
  }

  /* ---- deep dives ---- */
  .deepdive {
    padding: 70px 0;
  }
  .deepdive .grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 64px;
    align-items: center;
  }
  /* alternate the visual to the left on odd dives.
     .copy/.visual sit on child-component roots (no parent scope id),
     so target them with :global through the scoped .grid parent. */
  .deepdive.alt .grid > :global(.copy) {
    order: 2;
  }

  .deepdive .tag {
    font-size: 12px;
    letter-spacing: 2.5px;
    text-transform: uppercase;
    color: var(--dawn-1);
    margin-bottom: 18px;
  }
  .deepdive h2 {
    font-family: var(--font-display);
    font-weight: 300;
    font-size: clamp(30px, 4.4vw, 52px);
    letter-spacing: -1px;
    line-height: 1.05;
    max-width: 16ch;
    margin-bottom: 20px;
  }
  .deepdive h2 :global(em) {
    font-style: italic;
    color: var(--gold);
  }
  .deepdive .lead {
    font-size: 18px;
    color: var(--paper-dim);
    font-weight: 300;
    line-height: 1.6;
    max-width: 46ch;
    margin-bottom: 30px;
  }

  .points {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 20px;
  }
  .points li {
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding-left: 18px;
    border-left: 1px solid var(--border);
  }
  .p-title {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: 17px;
    color: var(--paper);
  }
  .p-body {
    font-size: 15.5px;
    color: var(--paper-dim);
    font-weight: 300;
    line-height: 1.6;
  }

  @media (max-width: 820px) {
    .f-intro {
      padding: 150px 0 40px;
    }
    .deepdive .grid {
      grid-template-columns: 1fr;
      gap: 40px;
    }
    /* on mobile, always lead with the copy, then the visual */
    .deepdive.alt .grid > :global(.copy) {
      order: 0;
    }
  }
</style>
