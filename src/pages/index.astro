---
import Base from "../layouts/Base.astro";
import Hero from "../components/Hero.astro";
import SectionReveal from "../components/SectionReveal.astro";
import AppMock from "../components/AppMock.astro";
import SlashCommandsMock from "../components/SlashCommandsMock.astro";
import LookingBackMock from "../components/LookingBackMock.astro";
import FormationMock from "../components/FormationMock.astro";
import PricingTiers from "../components/PricingTiers.astro";
import { pricingHonest } from "../content/site";
import {
  hero,
  problem,
  slashCommands,
  editor,
  lookingBack,
  formation,
  gain,
  bringHistory,
  privacy,
  pricing,
} from "../content/home";
---

<Base
  title="A journal built for spiritual growth"
  description="A journal for spiritual growth — prayer, scripture, and reflection rooted in time-tested practice, carried across week, month, quarter, and year."
  path="/"
>
  <Hero
    eyebrow={hero.eyebrow}
    lines={hero.lines}
    sub={hero.sub}
    verse={hero.verse}
    primary={hero.primary}
    ghost={hero.ghost}
  />

  {/* problem line */}
  <section class="problem">
    <SectionReveal class="wrap">
      <p>
        {problem.before}<span class="hl">{problem.highlight}</span>{problem.after}
      </p>
    </SectionReveal>
  </section>

  {/* slash commands — capture in flow */}
  <section class="slash-sec">
    <div class="wrap">
      <div class="slash-grid">
        <SectionReveal>
          <div class="tag">{slashCommands.tag}</div>
          <h2 set:html={slashCommands.heading} />
          <p class="lead">{slashCommands.lead}</p>
          <p class="bridge">{slashCommands.bridge}</p>
        </SectionReveal>
        <SectionReveal>
          <SlashCommandsMock
            commands={slashCommands.commands}
            editorLines={slashCommands.editorLines}
          />
        </SectionReveal>
      </div>
    </div>
  </section>

  {/* the editor — live mock */}
  <section class="showcase">
    <div class="wrap">
      <SectionReveal class="head">
        <div class="tag">{editor.tag}</div>
        <h2 set:html={editor.heading} />
        <p class="lead">{editor.lead}</p>
      </SectionReveal>

      <SectionReveal class="stage">
        <AppMock />
      </SectionReveal>
    </div>
  </section>

  {/* looking back — interactive horizon mock */}
  <section class="looking-back-sec">
    <SectionReveal class="wrap lb-head">
      <div class="tag">{lookingBack.tag}</div>
      <h2 set:html={lookingBack.heading} />
      <p class="lead">{lookingBack.lead}</p>
    </SectionReveal>
    <SectionReveal class="wrap lb-stage">
      <LookingBackMock horizons={lookingBack.horizons} />
    </SectionReveal>
  </section>

  {/* formation — the tasteful tell (mock left, text right) */}
  <section class="feature formation-sec">
    <div class="wrap">
      <div class="grid">
        <SectionReveal class="formation-visual">
          <FormationMock
            label={formation.mock.label}
            season={formation.mock.season}
            qualities={formation.mock.qualities}
            comingSoon
          />
        </SectionReveal>
        <SectionReveal>
          <div class="tag">{formation.tag}</div>
          <h2 set:html={formation.heading} />
          <p class="lead">{formation.lead}</p>
        </SectionReveal>
      </div>
    </div>
  </section>

  {/* the Gain — not the Gap */}
  <section class="gain">
    <SectionReveal class="wrap">
      <p class="q">&ldquo;{gain.quote}&rdquo;</p>
      <div class="a">{gain.attribution}</div>
    </SectionReveal>
  </section>

  {/* bring your history — import (text left, mock right) */}
  <section class="feature import-sec">
    <div class="wrap">
      <div class="grid">
        <SectionReveal>
          <div class="tag">{bringHistory.tag}</div>
          <h2 set:html={bringHistory.heading} />
          <p class="lead">{bringHistory.lead}</p>
        </SectionReveal>
        <SectionReveal>
          <div class="import-card">
            <div class="sources">
              {
                bringHistory.mock.sources.map((s) => (
                  <span class="source">{s}</span>
                ))
              }
            </div>
            <div class="import-flow" aria-hidden="true">↓</div>
            <div class="imported">{bringHistory.mock.imported}</div>
            <div class="ready">{bringHistory.mock.ready}</div>
          </div>
        </SectionReveal>
      </div>
    </div>
  </section>

  {/* privacy as stewardship — near-bare, centered; the one unmistakable line */}
  <section class="privacy-sec">
    <SectionReveal class="wrap">
      <div class="tag">{privacy.tag}</div>
      <h2 set:html={privacy.heading} />
      <p class="body">{privacy.body}</p>
      <p class="line">{privacy.line}</p>
    </SectionReveal>
  </section>

  {/* pricing */}
  <section class="pricing">
    <div class="wrap">
      <SectionReveal class="head">
        <div class="tag">{pricing.tag}</div>
        <h2 set:html={pricing.heading} />
        <p>{pricing.lead}</p>
      </SectionReveal>
      <SectionReveal>
        <PricingTiers />
      </SectionReveal>
      <SectionReveal as="p" class="honest">{pricingHonest}</SectionReveal>
    </div>
  </section>
</Base>

<style>
  /* ---- problem ---- */
  .problem {
    padding: 140px 0 120px;
    text-align: center;
  }
  .problem :global(p) {
    font-family: var(--font-display);
    font-weight: 300;
    font-size: clamp(26px, 4vw, 44px);
    line-height: 1.32;
    max-width: 20ch;
    margin: 0 auto;
    letter-spacing: -0.5px;
  }
  .problem :global(.hl) {
    color: var(--dawn-2);
    font-style: italic;
  }

  /* ---- slash commands (copy left, mock right) ---- */
  .slash-sec {
    padding: 0 0 100px;
  }
  .slash-grid {
    display: grid;
    grid-template-columns: 1fr 1.15fr;
    gap: 56px;
    align-items: center;
  }
  .slash-sec .tag {
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 2.5px;
    text-transform: uppercase;
    color: var(--dawn-1);
    margin-bottom: 20px;
  }
  .slash-sec h2 {
    font-family: var(--font-display);
    font-weight: 300;
    font-size: clamp(34px, 5vw, 56px);
    letter-spacing: -1px;
    line-height: 1.04;
    max-width: 14ch;
    margin-bottom: 18px;
  }
  .slash-sec h2 :global(em) {
    font-style: italic;
    color: var(--gold);
  }
  .slash-sec .lead {
    font-size: 19px;
    color: var(--paper-dim);
    font-weight: 300;
    max-width: 42ch;
    line-height: 1.55;
    margin-bottom: 22px;
  }
  .slash-sec .bridge {
    font-family: var(--font-display);
    font-style: italic;
    font-weight: 300;
    font-size: 17px;
    color: var(--muted);
    max-width: 38ch;
    line-height: 1.5;
  }
  @media (max-width: 900px) {
    .slash-grid {
      grid-template-columns: 1fr;
      gap: 40px;
    }
    .slash-sec h2 {
      max-width: none;
    }
  }

  /* ---- showcase (the editor) ---- */
  .showcase {
    padding: 30px 0 130px;
  }
  .showcase :global(.head) {
    text-align: center;
    margin-bottom: 56px;
  }
  .showcase .tag {
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 2.5px;
    text-transform: uppercase;
    color: var(--dawn-1);
    margin-bottom: 18px;
  }
  .showcase h2 {
    font-family: var(--font-display);
    font-weight: 300;
    font-size: clamp(34px, 5vw, 58px);
    letter-spacing: -1px;
    line-height: 1.04;
    margin-bottom: 18px;
  }
  .showcase h2 :global(em) {
    font-style: italic;
    color: var(--gold);
  }
  .showcase .lead {
    font-size: 18px;
    color: var(--paper-dim);
    font-weight: 300;
    max-width: 48ch;
    margin: 0 auto;
  }
  .showcase :global(.stage) {
    position: relative;
    max-width: 860px;
    margin: 0 auto;
    padding-bottom: 30px;
  }
  /* the dawn backlight behind the editor stage */
  .showcase :global(.stage)::before {
    content: "";
    position: absolute;
    left: 50%;
    top: -8%;
    transform: translateX(-50%);
    width: 90%;
    height: 95%;
    border-radius: 50%;
    z-index: 0;
    background: radial-gradient(
      ellipse at center,
      rgba(243, 189, 118, 0.2),
      transparent 65%
    );
    filter: blur(22px);
  }
  /* ---- looking back (centered, interactive mock) ---- */
  .looking-back-sec {
    padding: 60px 0 130px;
  }
  .looking-back-sec :global(.lb-head) {
    text-align: center;
    margin-bottom: 48px;
  }
  .looking-back-sec .tag {
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 2.5px;
    text-transform: uppercase;
    color: var(--dawn-1);
    margin-bottom: 20px;
  }
  .looking-back-sec h2 {
    font-family: var(--font-display);
    font-weight: 300;
    font-size: clamp(34px, 5vw, 60px);
    letter-spacing: -1px;
    line-height: 1.04;
    margin-bottom: 18px;
  }
  .looking-back-sec h2 :global(em) {
    font-style: italic;
    color: var(--gold);
  }
  .looking-back-sec .lead {
    font-size: 19px;
    color: var(--paper-dim);
    font-weight: 300;
    max-width: 42ch;
    margin: 0 auto;
  }
  .looking-back-sec :global(.lb-stage) {
    max-width: 720px;
    margin: 0 auto;
  }

  /* ---- feature (shared) ---- */
  .feature {
    padding: 60px 0 130px;
  }
  .feature .grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 64px;
    align-items: center;
  }
  .feature .tag {
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 2.5px;
    text-transform: uppercase;
    color: var(--dawn-1);
    margin-bottom: 20px;
  }
  .feature h2 {
    font-family: var(--font-display);
    font-weight: 300;
    font-size: clamp(34px, 5vw, 60px);
    letter-spacing: -1px;
    line-height: 1.04;
    max-width: 16ch;
    margin-bottom: 22px;
  }
  .feature h2 :global(em) {
    font-style: italic;
    color: var(--gold);
  }
  .feature .lead {
    font-size: 19px;
    color: var(--paper-dim);
    max-width: 48ch;
    font-weight: 300;
  }

  @media (max-width: 820px) {
    .feature .grid {
      grid-template-columns: 1fr;
      gap: 40px;
    }
  }

  /* ---- gain ---- */
  .gain {
    padding: 120px 0;
    text-align: center;
    position: relative;
  }
  .gain :global(.q) {
    font-family: var(--font-display);
    font-weight: 300;
    font-style: italic;
    font-size: clamp(28px, 4.4vw, 50px);
    line-height: 1.28;
    max-width: 18ch;
    margin: 0 auto 18px;
    letter-spacing: -0.5px;
  }
  .gain :global(.a) {
    font-family: var(--font-mono);
    font-size: 13px;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: var(--dawn-1);
  }

  /* ---- formation (mock left, text right) ---- */
  .formation-sec {
    padding: 0 0 130px;
  }
  /* on mobile, lead with the text, then the visual */
  @media (max-width: 820px) {
    .formation-sec .grid > :global(.formation-visual) {
      order: 2;
    }
  }

  /* ---- bring your history / import ---- */
  .import-sec {
    padding: 0 0 130px;
  }
  .import-card {
    background: linear-gradient(165deg, var(--ink-3), var(--ink-2));
    border: 1px solid var(--border);
    border-radius: 18px;
    padding: 32px;
    text-align: center;
    box-shadow:
      0 40px 80px -40px rgba(0, 0, 0, 0.8),
      0 0 60px -30px rgba(243, 189, 118, 0.18);
  }
  .import-card .sources {
    display: flex;
    gap: 10px;
    justify-content: center;
    flex-wrap: wrap;
  }
  .import-card .source {
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.3px;
    color: var(--paper-dim);
    border: 1px solid var(--border);
    border-radius: 100px;
    padding: 7px 14px;
  }
  .import-card .import-flow {
    color: var(--dawn-1);
    font-size: 20px;
    margin: 16px 0 14px;
  }
  .import-card .imported {
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 1px;
    text-transform: uppercase;
    color: var(--dawn-1);
    margin-bottom: 12px;
  }
  .import-card .ready {
    font-family: var(--font-display);
    font-weight: 400;
    font-style: italic;
    font-size: 21px;
    color: var(--paper);
  }

  /* ---- privacy as stewardship (near-bare, centered) ---- */
  .privacy-sec {
    padding: 30px 0 120px;
    text-align: center;
  }
  .privacy-sec .tag {
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 2.5px;
    text-transform: uppercase;
    color: var(--dawn-1);
    margin-bottom: 22px;
  }
  .privacy-sec h2 {
    font-family: var(--font-display);
    font-weight: 300;
    font-size: clamp(28px, 4.4vw, 50px);
    letter-spacing: -0.5px;
    line-height: 1.14;
    max-width: 20ch;
    margin: 0 auto 26px;
  }
  .privacy-sec h2 :global(em) {
    font-style: italic;
    color: var(--gold);
  }
  .privacy-sec .body {
    font-size: 18px;
    color: var(--paper-dim);
    font-weight: 300;
    line-height: 1.62;
    max-width: 52ch;
    margin: 0 auto 30px;
  }
  /* the one unmistakable line — placed with confidence */
  .privacy-sec .line {
    font-family: var(--font-display);
    font-weight: 300;
    font-style: italic;
    font-size: clamp(22px, 3vw, 32px);
    letter-spacing: -0.3px;
    color: var(--gold);
    max-width: 24ch;
    margin: 0 auto;
  }

  /* ---- pricing ---- */
  .pricing {
    padding: 40px 0 120px;
  }
  .pricing :global(.head) {
    text-align: center;
    margin-bottom: 60px;
  }
  .pricing .tag {
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 2.5px;
    text-transform: uppercase;
    color: var(--dawn-1);
    margin-bottom: 18px;
  }
  .pricing h2 {
    font-family: var(--font-display);
    font-weight: 300;
    font-size: clamp(32px, 5vw, 56px);
    letter-spacing: -1px;
    line-height: 1.05;
    margin-bottom: 16px;
  }
  .pricing h2 :global(em) {
    font-style: italic;
    color: var(--gold);
  }
  .pricing :global(.head) p {
    color: var(--paper-dim);
    font-weight: 300;
    font-size: 18px;
    max-width: 44ch;
    margin: 0 auto;
  }
  .pricing :global(.honest) {
    text-align: center;
    margin-top: 36px;
    font-style: italic;
    color: var(--muted);
    font-size: 15px;
  }
</style>
