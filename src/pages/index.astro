---
import Base from "../layouts/Base.astro";
import Hero from "../components/Hero.astro";
import SectionReveal from "../components/SectionReveal.astro";
import WritingGlimpse from "../components/WritingGlimpse.astro";
import RitualsGlimpse from "../components/RitualsGlimpse.astro";
import AscentGlimpse from "../components/AscentGlimpse.astro";
import ScriptureTeaser from "../components/ScriptureTeaser.astro";
import PricingTiers from "../components/PricingTiers.astro";
import { pricingHonest } from "../content/site";
import {
  hero,
  problem,
  writingPage,
  editor,
  practices,
  lookingBack,
  altar,
  scripture,
  bringHistory,
  privacy,
  pricing,
} from "../content/home";
---

<Base
  title="See who you're becoming"
  description="A private journal that turns what you write each day into a year-long mirror — climb from the week to the year and see how far you've come, not just how you feel today."
  path="/"
>
  <Hero
    eyebrow={hero.eyebrow}
    lines={hero.lines}
    sub={hero.sub}
    verse={hero.verse}
    primary={hero.primary}
    ghost={hero.ghost}
    mockCaption={hero.mockCaption}
    appMock={hero.appMock}
  />

  {/* problem line */}
  <section class="problem">
    <SectionReveal class="wrap">
      <p>
        {problem.before}<span class="hl">{problem.highlight}</span>{problem.after}
      </p>
    </SectionReveal>
  </section>

  {/* the page you write on — editor + slash, one story: a page that gets out
      of the way, and capture that never makes you leave the line */}
  <section class="writing-sec">
    <div class="wrap">
      <SectionReveal class="writing-head">
        <div class="tag">{writingPage.tag}</div>
        <h2 set:html={writingPage.heading} />
        <p class="lead" set:html={writingPage.lead} />
      </SectionReveal>
      <SectionReveal>
        <ul class="conveniences">
          {
            writingPage.conveniences.map((c) => (
              <li>
                <span class="c-cmd mono">{c.command}</span>
                <span class="c-title">{c.title}</span>
                <span class="c-body">{c.body}</span>
              </li>
            ))
          }
        </ul>
      </SectionReveal>
      <SectionReveal class="writing-mock">
        <WritingGlimpse
          line={writingPage.glimpse.line}
          fuzzy={writingPage.glimpse.fuzzy}
          match={writingPage.glimpse.match}
          canon={writingPage.glimpse.canon}
        />
        <p class="bridge">{writingPage.bridge}</p>
      </SectionReveal>
      <SectionReveal>
        <ul class="highlights">
          {
            editor.highlights.map((h) => (
              <li>
                <span class="h-title">{h.title}</span>
                <span class="h-body">{h.body}</span>
              </li>
            ))
          }
        </ul>
      </SectionReveal>
    </div>
  </section>

  {/* the Practices — contemplative writing forms via /practice */}
  <section class="practices-sec">
    <SectionReveal class="wrap practices-head">
      <div class="tag">{practices.tag}</div>
      <h2 set:html={practices.heading} />
      <p class="lead" set:html={practices.lead} />
    </SectionReveal>
    <SectionReveal class="wrap practices-stage">
      <RitualsGlimpse rituals={practices.rituals} foot={practices.foot} />
    </SectionReveal>
  </section>

  {/* the Ascent — the payoff: what the daily page becomes over time */}
  <section class="looking-back-sec">
    <SectionReveal class="wrap lb-head">
      <div class="tag">{lookingBack.tag}</div>
      <h2 set:html={lookingBack.heading} />
      <p class="lead">{lookingBack.lead}</p>
    </SectionReveal>
    <SectionReveal class="wrap lb-stage">
      <AscentGlimpse
        altitudes={lookingBack.glimpse.altitudes}
        activeAlt={lookingBack.glimpse.activeAlt}
        activeLabel={lookingBack.glimpse.activeLabel}
        oneLine={lookingBack.glimpse.oneLine}
        verseRef={lookingBack.glimpse.verseRef}
        lenses={lookingBack.lenses}
        hint={lookingBack.glimpse.hint}
      />
      <p class="lb-caption">{lookingBack.caption}</p>
    </SectionReveal>
  </section>

  {/* the Lamp — scripture canon map: copy left, glimpse right */}
  <section class="feature scripture-sec">
    <div class="wrap">
      <div class="grid">
        <SectionReveal>
          <div class="tag">{scripture.tag}</div>
          <h2 set:html={scripture.heading} />
          <p class="lead">{scripture.lead}</p>
        </SectionReveal>
        <SectionReveal>
          <ScriptureTeaser preview />
        </SectionReveal>
      </div>
    </div>
  </section>

  {/* bring your history — import (text left, mock right) */}
  <section class="feature import-sec">
    <div class="wrap">
      <div class="grid">
        <SectionReveal>
          <div class="tag">{bringHistory.tag}</div>
          <h2 set:html={bringHistory.heading} />
          <p class="lead">{bringHistory.lead}</p>
        </SectionReveal>
        <SectionReveal>
          <div class="import-card">
            <div class="sources">
              {
                bringHistory.mock.sources.map((s) => (
                  <span class="source">{s}</span>
                ))
              }
            </div>
            <div class="import-flow" aria-hidden="true">↓</div>
            <div class="imported">{bringHistory.mock.imported}</div>
            <div class="ready">{bringHistory.mock.ready}</div>
          </div>
        </SectionReveal>
      </div>
    </div>
  </section>

  {/* privacy as stewardship — near-bare, centered; the one unmistakable line */}
  <section class="privacy-sec">
    <SectionReveal class="wrap">
      <div class="tag">{privacy.tag}</div>
      <h2 set:html={privacy.heading} />
      <p class="body">{privacy.body}</p>
      <p class="line">{privacy.line}</p>
    </SectionReveal>
  </section>

  {/* altar — coming soon: a small, quiet teaser */}
  <section class="altar-teaser">
    <SectionReveal class="wrap">
      <div class="teaser-card">
        <div class="tag">{altar.tag}</div>
        <h2 set:html={altar.heading} />
        <p class="lead">{altar.lead}</p>
      </div>
    </SectionReveal>
  </section>

  {/* pricing */}
  <section class="pricing">
    <div class="wrap">
      <SectionReveal class="head">
        <div class="tag">{pricing.tag}</div>
        <h2 set:html={pricing.heading} />
        <p>{pricing.lead}</p>
      </SectionReveal>
      <SectionReveal>
        <PricingTiers />
      </SectionReveal>
      <SectionReveal as="p" class="honest">{pricingHonest}</SectionReveal>
    </div>
  </section>
</Base>

<style>
  /* ---- problem ---- */
  .problem {
    padding: 140px 0 120px;
    text-align: center;
  }
  .problem :global(p) {
    font-family: var(--font-display);
    font-weight: 300;
    font-size: clamp(26px, 4vw, 44px);
    line-height: 1.32;
    max-width: 20ch;
    margin: 0 auto;
    letter-spacing: -0.5px;
  }
  .problem :global(.hl) {
    color: var(--dawn-2);
    font-style: italic;
  }

  /* ---- the page you write on (centered head → mock → highlight cards) ---- */
  .writing-sec {
    padding: 0 0 110px;
  }
  .writing-sec :global(.writing-head) {
    text-align: center;
    margin-bottom: 40px;
  }
  .writing-sec .tag {
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 2.5px;
    text-transform: uppercase;
    color: var(--dawn-1);
    margin-bottom: 20px;
  }
  .writing-sec h2 {
    font-family: var(--font-display);
    font-weight: 300;
    font-size: clamp(34px, 5vw, 56px);
    letter-spacing: -1px;
    line-height: 1.04;
    max-width: 18ch;
    margin: 0 auto 18px;
  }
  .writing-sec h2 :global(em) {
    font-style: italic;
    color: var(--gold);
  }
  .writing-sec .lead {
    font-size: 19px;
    color: var(--paper-dim);
    font-weight: 300;
    max-width: 52ch;
    line-height: 1.55;
    margin: 0 auto;
  }
  .writing-sec .lead :global(em) {
    font-style: normal;
    font-family: var(--font-mono);
    color: var(--gold);
  }
  .conveniences {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 22px;
    text-align: left;
    max-width: 920px;
    margin: 0 auto 40px;
  }
  .conveniences li {
    padding: 20px 22px;
    border: 1px solid var(--border);
    border-radius: 14px;
    background: rgba(18, 19, 25, 0.35);
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .c-cmd {
    font-size: 11px;
    letter-spacing: 0.3px;
    color: var(--dawn-1);
  }
  .c-title {
    font-family: var(--font-display);
    font-size: 17px;
    color: var(--paper);
    line-height: 1.2;
  }
  .c-body {
    font-size: 14.5px;
    line-height: 1.55;
    color: var(--paper-dim);
    font-weight: 300;
  }
  .writing-sec :global(.writing-mock) {
    max-width: 520px;
    margin: 0 auto 40px;
  }
  .writing-sec .bridge {
    font-family: var(--font-display);
    font-style: italic;
    font-weight: 300;
    font-size: 17px;
    color: var(--muted);
    max-width: 46ch;
    line-height: 1.5;
    text-align: center;
    margin: 22px auto 0;
  }
  .highlights {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 28px;
    text-align: left;
    max-width: 920px;
    margin: 0 auto;
  }
  .highlights li {
    padding: 22px 24px;
    border: 1px solid var(--border);
    border-radius: 14px;
    background: rgba(18, 19, 25, 0.4);
  }
  .h-title {
    display: block;
    font-family: var(--font-display);
    font-size: 17px;
    color: var(--paper);
    margin-bottom: 8px;
  }
  .h-body {
    font-size: 14.5px;
    line-height: 1.55;
    color: var(--paper-dim);
    font-weight: 300;
  }
  @media (max-width: 820px) {
    .conveniences {
      grid-template-columns: 1fr;
      max-width: 420px;
      margin-left: auto;
      margin-right: auto;
    }
    .highlights {
      grid-template-columns: 1fr;
      max-width: 420px;
    }
  }
  /* ---- the Practices ---- */
  .practices-sec {
    padding: 0 0 110px;
  }
  .practices-sec :global(.practices-head) {
    text-align: center;
    margin-bottom: 40px;
  }
  .practices-sec .tag {
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 2.5px;
    text-transform: uppercase;
    color: var(--dawn-1);
    margin-bottom: 18px;
  }
  .practices-sec h2 {
    font-family: var(--font-display);
    font-weight: 300;
    font-size: clamp(30px, 4.4vw, 52px);
    letter-spacing: -1px;
    line-height: 1.05;
    margin-bottom: 18px;
  }
  .practices-sec h2 :global(em) {
    font-style: italic;
    color: var(--gold);
  }
  .practices-sec .lead {
    font-size: 19px;
    color: var(--paper-dim);
    font-weight: 300;
    max-width: 52ch;
    line-height: 1.55;
    margin: 0 auto;
  }
  .practices-sec .lead :global(em) {
    font-style: normal;
    font-family: var(--font-mono);
    color: var(--gold);
  }
  .practices-sec :global(.practices-stage) {
    max-width: 720px;
    margin: 0 auto;
  }
  /* ---- looking back (centered, interactive mock) ---- */
  .looking-back-sec {
    padding: 80px 0 140px;
  }
  .looking-back-sec :global(.lb-head) {
    text-align: center;
    margin-bottom: 48px;
  }
  .looking-back-sec .tag {
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 2.5px;
    text-transform: uppercase;
    color: var(--dawn-1);
    margin-bottom: 20px;
  }
  .looking-back-sec h2 {
    font-family: var(--font-display);
    font-weight: 300;
    font-size: clamp(34px, 5vw, 60px);
    letter-spacing: -1px;
    line-height: 1.04;
    margin-bottom: 18px;
  }
  .looking-back-sec h2 :global(em) {
    font-style: italic;
    color: var(--gold);
  }
  .looking-back-sec .lead {
    font-size: 19px;
    color: var(--paper-dim);
    font-weight: 300;
    max-width: 42ch;
    margin: 0 auto;
  }
  .looking-back-sec :global(.lb-stage) {
    max-width: 560px;
    margin: 0 auto;
  }
  .looking-back-sec .lb-caption {
    font-family: var(--font-display);
    font-style: italic;
    font-weight: 300;
    font-size: clamp(14px, 1.6vw, 17px);
    color: var(--muted);
    text-align: center;
    max-width: 44ch;
    margin: 24px auto 0;
    line-height: 1.5;
  }

  /* ---- feature (shared) ---- */
  .feature {
    padding: 80px 0 120px;
  }
  .feature .grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 72px;
    align-items: center;
  }
  .feature .tag {
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 2.5px;
    text-transform: uppercase;
    color: var(--dawn-1);
    margin-bottom: 20px;
  }
  .feature h2 {
    font-family: var(--font-display);
    font-weight: 300;
    font-size: clamp(34px, 5vw, 60px);
    letter-spacing: -1px;
    line-height: 1.04;
    max-width: 16ch;
    margin-bottom: 22px;
  }
  .feature h2 :global(em) {
    font-style: italic;
    color: var(--gold);
  }
  .feature .lead {
    font-size: 19px;
    color: var(--paper-dim);
    max-width: 48ch;
    font-weight: 300;
  }

  @media (max-width: 820px) {
    .feature .grid {
      grid-template-columns: 1fr;
      gap: 40px;
    }
  }

  @media (max-width: 640px) {
    .feature {
      padding: 60px 0 80px;
    }
    .writing-sec {
      padding: 0 0 80px;
    }
    .scripture-sec {
      padding-bottom: 80px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    /* SectionReveal already handles .reveal — no extra rules needed here */
  }

  /* scripture column gets more room for the heatmap */
  .scripture-sec .grid {
    grid-template-columns: 0.88fr 1.12fr;
  }

  /* the Lamp sits right under the Ascent */
  .scripture-sec {
    padding-top: 0;
    padding-bottom: 120px;
  }

  /* ---- bring your history / import ---- */
  .import-sec {
    padding: 0 0 130px;
  }
  .import-card {
    background: linear-gradient(165deg, var(--ink-3), var(--ink-2));
    border: 1px solid var(--border);
    border-radius: 18px;
    padding: 32px;
    text-align: center;
    box-shadow:
      0 40px 80px -40px rgba(0, 0, 0, 0.8),
      0 0 60px -30px rgba(243, 189, 118, 0.18);
  }
  .import-card .sources {
    display: flex;
    gap: 10px;
    justify-content: center;
    flex-wrap: wrap;
  }
  .import-card .source {
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.3px;
    color: var(--paper-dim);
    border: 1px solid var(--border);
    border-radius: 100px;
    padding: 7px 14px;
  }
  .import-card .import-flow {
    color: var(--dawn-1);
    font-size: 20px;
    margin: 16px 0 14px;
  }
  .import-card .imported {
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 1px;
    text-transform: uppercase;
    color: var(--dawn-1);
    margin-bottom: 12px;
  }
  .import-card .ready {
    font-family: var(--font-display);
    font-weight: 400;
    font-style: italic;
    font-size: 21px;
    color: var(--paper);
  }

  /* ---- privacy as stewardship (near-bare, centered) ---- */
  .privacy-sec {
    padding: 30px 0 120px;
    text-align: center;
  }
  .privacy-sec .tag {
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 2.5px;
    text-transform: uppercase;
    color: var(--dawn-1);
    margin-bottom: 22px;
  }
  .privacy-sec h2 {
    font-family: var(--font-display);
    font-weight: 300;
    font-size: clamp(28px, 4.4vw, 50px);
    letter-spacing: -0.5px;
    line-height: 1.14;
    max-width: 20ch;
    margin: 0 auto 26px;
  }
  .privacy-sec h2 :global(em) {
    font-style: italic;
    color: var(--gold);
  }
  .privacy-sec .body {
    font-size: 18px;
    color: var(--paper-dim);
    font-weight: 300;
    line-height: 1.62;
    max-width: 52ch;
    margin: 0 auto 30px;
  }
  /* the one unmistakable line — placed with confidence */
  .privacy-sec .line {
    font-family: var(--font-display);
    font-weight: 300;
    font-style: italic;
    font-size: clamp(22px, 3vw, 32px);
    letter-spacing: -0.3px;
    color: var(--gold);
    max-width: 24ch;
    margin: 0 auto;
  }

  /* ---- altar — coming soon teaser (small, quiet) ---- */
  .altar-teaser {
    padding: 0 0 110px;
    text-align: center;
  }
  .altar-teaser .teaser-card {
    max-width: 520px;
    margin: 0 auto;
    padding: 40px 40px 44px;
    border: 1px solid var(--border);
    border-radius: 18px;
    background: linear-gradient(165deg, var(--ink-3), var(--ink-2));
  }
  .altar-teaser .tag {
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 2.5px;
    text-transform: uppercase;
    color: var(--dawn-1);
    margin-bottom: 18px;
  }
  .altar-teaser h2 {
    font-family: var(--font-display);
    font-weight: 300;
    font-size: clamp(26px, 3.6vw, 38px);
    letter-spacing: -0.5px;
    line-height: 1.1;
    margin-bottom: 16px;
  }
  .altar-teaser h2 :global(em) {
    font-style: italic;
    color: var(--gold);
  }
  .altar-teaser .lead {
    font-size: 16.5px;
    color: var(--paper-dim);
    font-weight: 300;
    line-height: 1.6;
    max-width: 42ch;
    margin: 0 auto;
  }

  /* ---- pricing ---- */
  .pricing {
    padding: 40px 0 120px;
  }
  .pricing :global(.head) {
    text-align: center;
    margin-bottom: 60px;
  }
  .pricing .tag {
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 2.5px;
    text-transform: uppercase;
    color: var(--dawn-1);
    margin-bottom: 18px;
  }
  .pricing h2 {
    font-family: var(--font-display);
    font-weight: 300;
    font-size: clamp(32px, 5vw, 56px);
    letter-spacing: -1px;
    line-height: 1.05;
    margin-bottom: 16px;
  }
  .pricing h2 :global(em) {
    font-style: italic;
    color: var(--gold);
  }
  .pricing :global(.head) p {
    color: var(--paper-dim);
    font-weight: 300;
    font-size: 18px;
    max-width: 44ch;
    margin: 0 auto;
  }
  .pricing :global(.honest) {
    text-align: center;
    margin-top: 36px;
    font-style: italic;
    color: var(--muted);
    font-size: 15px;
  }
</style>
